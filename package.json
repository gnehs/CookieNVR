{
  "name": "cookienvr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATA_DIR=./data bun run --watch src/main.ts",
    "dev:web": "bun --bun vite",
    "dev:mock": "bun scripts/dev-mock.ts",
    "build": "bun --bun vite build",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-plugin": "1.169.0",
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5",
    "vite": "8.3.8"
  },
  "dependencies": {
    "hap-nodejs": "0.14.3",
    "tweetnacl": "1.0.3"
  }
}
